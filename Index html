.card a {
  display: inline-block;
  margin-top: 10px;
  background: #4338ca;
  color: white;
  padding: 9px 13px;
  border-radius: 8px;
  text-decoration: none;
}
footer {
  text-align: center;
  padding: 20px;
  color: #555;
}
</style>
</head>
